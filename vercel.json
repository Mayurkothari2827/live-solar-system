{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 build_static.py",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{server.py,kernels/**,assets/moon-files.json}",
      "excludeFiles": "{node_modules/**,android/**,ios/**,native*/**,scripts/**,public/**,cache/**,.venv/**,tests/**,**/__pycache__/**,assets/**/*.{jpg,jpeg,png,webp,js,license},LICENSES/**,assets/space/**}"
    }
  },
  "rewrites": [
    {
      "source": "/space",
      "destination": "/space.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=:path*"
    }
  ]
}
