{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 build_static.py",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{server.py,kernels/**,assets/moon-files.json}",
      "excludeFiles": "{public/**,cache/**,.venv/**,tests/**,**/__pycache__/**,assets/**/*.jpg,assets/**/*.jpeg,assets/**/*.png,assets/**/*.webp,assets/**/*.js,assets/**/*.license,LICENSES/**,assets/bikaner*.json,assets/bikaner-imagery/**,assets/city-materials/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=:path*"
    },
    {
      "source": "/city",
      "destination": "/city.html"
    }
  ]
}
